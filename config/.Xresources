Xft.dpi: 96
Xft.antialias: true
Xft.hinting: true
Xft.rgba: rgb
Xft.autohint: false
Xft.hintstyle: hintslight
Xft.lcdfilter: lcddefault

Xcursor.theme: xcursor-breeze
Xcursor.size: 0

! Colors (Synced with Kitty theme)
*background: #000000
*foreground: #dddddd
*cursorColor: #1688f0
*pointerColorBackground: #000000
*pointerColorForeground: #1688f0

!! Normal Colors
*color0: #000000
*color1: #e00606
*color2: #3ed50a
*color3: #f1c200
*color4: #0d73cc
*color5: #cb1ed1
*color6: #0dcdcd
*color7: #dddddd

!! Bright Colors
*color8: #767676
*color9: #ff0043
*color10: #00f955
*color11: #fffd00
*color12: #1a8fff
*color13: #fd28ff
*color14: #14ffff
*color15: #ffffff

! ==========================================
! Modern XTerm Configuration
! ==========================================
! Fonts & Text Rendering
XTerm*faceName: xft:FiraCode Nerd Font:size=9,xft:DejaVu Sans Mono:size=9
XTerm*faceNameDoublesize: xft:FiraCode Nerd Font:size=9
XTerm*renderFont: true
XTerm*scaleHeight: 1.05
XTerm*forceBoxChars: false
XTerm*utf8: 2
XTerm*locale: true
XTerm*termName: xterm-256color
XTerm*dynamicColors: true

! Window & Aesthetics
XTerm*scrollBar: false
XTerm*saveLines: 10000
XTerm*internalBorder: 8
XTerm*cursorBlink: true
XTerm*pointerShape: left_ptr
XTerm*bellIsUrgent: true

! Clipboard Integration & Modern Shortcuts (Ctrl+Shift+C / Ctrl+Shift+V)
XTerm*selectToClipboard: true
XTerm*VT100.translations: #override \
    Ctrl Shift <Key>C: copy-selection(CLIPBOARD) \n\
    Ctrl Shift <Key>V: insert-selection(CLIPBOARD)

! Smart URL / Path Word Selection on Double Click
XTerm*charClass: 33:48,36-47:48,58-59:48,61:48,63-64:48,126:48

! ==========================================
! URxvt Configuration
! ==========================================
URxvt.font: xft:FiraCode Nerd Font Mono:size=9,xft:DejaVu Sans Mono:size=9
URxvt.boldFont: xft:FiraCode Nerd Font Mono:bold:size=9
URxvt.letterSpace: -1
URxvt.internalBorder: 8
URxvt.depth: 32
URxvt.scrollBar: false
URxvt.mouseWheelScrollPage: false
URxvt.cursorBlink: true
URxvt.background: #000000
URxvt.foreground: #dddddd
URxvt.saveLines: 5000

! Normal copy-paste keybindings without perls
URxvt.iso14755: false
URxvt.keysym.Shift-Control-V: eval:paste_clipboard
URxvt.keysym.Shift-Control-C: eval:selection_to_clipboard

! Xterm escape codes, word by word movement
URxvt.keysym.Control-Left: \033[1;5D
URxvt.keysym.Shift-Control-Left: \033[1;6D
URxvt.keysym.Control-Right: \033[1;5C
URxvt.keysym.Shift-Control-Right: \033[1;6C
URxvt.keysym.Control-Up: \033[1;5A
URxvt.keysym.Shift-Control-Up: \033[1;6A
URxvt.keysym.Control-Down: \033[1;5B
URxvt.keysym.Shift-Control-Down: \033[1;6B
